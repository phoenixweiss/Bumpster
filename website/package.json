{
  "name": "bumpster-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:check": "node scripts/verify-content.mjs",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "check": "yarn run lint && yarn run format:check && yarn run content:check && yarn run build",
    "check:full": "yarn run check && yarn run lighthouse"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.8.0",
    "lighthouse": "13.4.1",
    "prettier": "3.9.6",
    "vite": "8.2.0",
    "vue-eslint-parser": "10.4.1"
  }
}
